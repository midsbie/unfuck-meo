# Configuration loaded by meo-ipv6-fix.service.

# Devices whose Game & Application Sharing rules must stay IPv6, separated by spaces, named as the
# router lists them. Set at least one device before enabling the timer.
MEO_DEVICES=

# Router web UI and credentials.
#MEO_URL=http://192.168.1.254
#MEO_USER=meo
#MEO_PASSWORD=meo
