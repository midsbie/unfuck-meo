# Configuration loaded by meo-ipv6-fix.service.

# Devices whose Game & Application Sharing rules must stay IPv6, separated by spaces: names as the
# router lists them (nas) or colon-separated MAC addresses (02:00:00:00:00:01). Set at least one
# device before enabling the timer.
MEO_DEVICES=

# Router web UI and credentials.
#MEO_URL=http://192.168.1.254
#MEO_USER=meo
#MEO_PASSWORD=meo

# Canary: a URL reachable from the Internet only through the rules, e.g. a Cloudflare-proxied name
# whose only origin record is the device's IPv6 address. While it answers 2xx the rules work and the
# router is left alone.
#MEO_CANARY=https://cloud.example.com/
